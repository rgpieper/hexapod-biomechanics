# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments. The glob also catches the " 2"/" 3"-suffixed copies
# a cloud-sync agent leaves behind when the repo lives in a synced folder
# (see scripts/install.py).
.venv*

# Subject data and raw captures (too large and/or sensitive for git)
subjects/
data/

# Model weights — hosted as GitHub Release assets, fetched via scripts/download_weights.py
models/*.pth

# Notebooks (kept locally for reference; pipeline scripts are the canonical entry points)
notebooks/

# Sandbox / throwaway scripts
.sandbox/

.DS_Store